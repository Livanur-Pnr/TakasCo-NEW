# Prod build için API adresi (sonunda / olmadan). Boş bırakılırsa geliştirmede
# Metro'nun LAN IP'si / localhost üzerinden http://<host>:8000 kullanılır.
EXPO_PUBLIC_API_URL=

# Gerçek zamanlı mesajlaşma (Reverb). EXPO_PUBLIC_REVERB_KEY boşsa WebSocket kapalıdır ve uygulama polling ile çalışır.
# Değer, backend/.env içindeki REVERB_APP_KEY ile aynı olmalıdır (istemci anahtarı gizli değildir; REVERB_APP_SECRET asla buraya yazılmaz).
# Yerel geliştirmede kendi bilgisayarınızda `mobile/.env.local` dosyasına yazın (git'e girmez).
EXPO_PUBLIC_REVERB_KEY=
EXPO_PUBLIC_REVERB_HOST=
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http

# Google ile giriş (yalnızca web). backend GOOGLE_CLIENT_ID ile aynı istemci kimliği; boşsa düğme gösterilmez.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
